#!/usr/bin/env sh
# Wrapper that locates semsea.jar relative to this script and runs it.
# Works both from the project root (uses target/semsea.jar) and from
# an install directory (uses semsea.jar next to this script).

set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$DIR/semsea.jar"
if [ ! -f "$JAR" ]; then
    JAR="$DIR/target/semsea.jar"
fi
if [ ! -f "$JAR" ]; then
    echo "semsea.jar not found." >&2
    echo "Build it first with: mvn package" >&2
    exit 1
fi

exec java --enable-native-access=ALL-UNNAMED -jar "$JAR" "$@"
